# Application runtime: zulu, graalvm or semeru (same JAR, not a native executable)
VAULT_JVM_RUNTIME=zulu

# Vault read access: comma-separated Alfresco group IDs; administrators always retain access
VAULT_READERS_GROUPS=GROUP_ANV_READERS

# Content compression: Zstandard for new binaries; level 1-9
VAULT_COMPRESS_CONTENT=true
VAULT_COMPRESSION_LEVEL=3

# Application metrics: archive/restore/delete counters, durations and archived bytes
VAULT_OPERATION_METRICS_ENABLED=true

# Alfresco Content Services, transformations, Share and search
ACS_IMAGE=alfresco/alfresco-content-repository-community
ACS_VERSION=26.2.0
TRANSFORM_CORE_AIO_IMAGE=alfresco/alfresco-transform-core-aio
TRANSFORM_CORE_AIO_VERSION=5.4.3
SHARE_IMAGE=alfresco/alfresco-share
SHARE_VERSION=26.2.2
ASS_IMAGE=alfresco/alfresco-search-services
ASS_VERSION=2.0.21

# Alfresco database and message broker
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=18-alpine
ACTIVEMQ_IMAGE=alfresco/alfresco-activemq
ACTIVEMQ_VERSION=6.2-jre17-rockylinux8

# Vault metadata database and administration UI
MONGO_IMAGE=mongo
MONGO_EXPRESS_IMAGE=mongo-express

# Content storage: S3 emulator and Apache Ozone
MOTOSERVER_IMAGE=motoserver/moto:latest
OZONE_IMAGE=apache/ozone
OZONE_VERSION=2.2.1

# Encryption secret storage: HashiCorp Vault
HASHICORP_VAULT_IMAGE=hashicorp/vault
HASHICORP_VAULT_IMAGE_VERSION=latest

# Monitoring: Prometheus, Grafana and Nginx
PROMETHEUS_IMAGE=prom/prometheus
GRAFANA_IMAGE=grafana/grafana:12.4
NGINX_IMAGE=nginx:alpine

# Log aggregation: Loki and Promtail
LOKI_IMAGE=grafana/loki:3.7
PROMTAIL_IMAGE=grafana/promtail:3.6.11

@startuml
!pragma layout smetana
!include <C4/C4_Container>
!include <C4/C4_Component>

hide stereotype

title Alfresco Node Vault

Component(client, "Client")

System_Boundary(anv, "Alfresco Node Vault") {
  Component(anvProxy, "Proxy")
  Component(anvApi, "REST API", "/api/v1")
  Component(anvJob, "Scheduled jobs", "", "Archiving, notarization and integrity sweeps")
  Component(anvHandler, "Event handler")
  Component(anvNotarization, "NotarizationService", "", "Notarization and verification")
  Component(anvVault, "VaultService", "", "Archive, download, restore and delete")
  Component(anvAlfresco, "AlfrescoService")
  Component(anvNode, "NodeService", "", "Plain or encrypted metadata")
  Component(anvContent, "ContentService", "", "S3, GridFS or Ozone")
  Component(anvCrypto, "CryptoService", "ANV v1", "Metadata and content encryption")
  Component(anvSecret, "SecretService")
}

System_Boundary(acs, "Alfresco Content Services") {
  Component(acsApi, "REST API")
  ComponentQueue(acsQueue, "ActiveMQ")
}

System_Ext(blockchain, "Ethereum", "Content hash notarization")
System_Ext(secrets, "HashiCorp Vault", "Versioned encryption secrets")

Boundary(storage, "Persistence") {
  ContainerDb(anvMongo, "MongoDB", "", "Metadata and audit")
  ContainerDb(anvGrid, "GridFS")
  ContainerDb(anvS3, "S3 / compatible")
  ContainerDb(anvOzone, "Apache Ozone")
}

' Entry points
Rel_D(client, anvProxy, "")
Rel_D(client, anvApi, "")
Rel_R(anvProxy, anvApi, "vault content")
Rel_R(anvProxy, acsApi, "other requests")
Rel_L(acsQueue, anvHandler, "events")

' Services
Rel_D(anvApi, anvVault, "")
Rel_D(anvJob, anvVault, "archive")
Rel_D(anvHandler, anvVault, "")
Rel_D(anvApi, anvNotarization, "")
Rel_D(anvJob, anvNotarization, "notarize / verify")
Rel_R(anvVault, anvAlfresco, "")
Rel_U(anvAlfresco, acsApi, "read, restore, delete; optional locks")
Rel_D(anvVault, anvNode, "metadata")
Rel_D(anvVault, anvContent, "content")
Rel_D(anvNotarization, anvNode, "")
Rel_D(anvNotarization, anvContent, "")
Rel_L(anvNotarization, blockchain, "")

' Encryption
Rel_D(anvNode, anvCrypto, "optional")
Rel_D(anvContent, anvCrypto, "optional")
Rel_R(anvCrypto, anvSecret, "")
Rel_D(anvSecret, secrets, "versioned keys")

' Persistence
Rel_D(anvNode, anvMongo, "")
Rel_D(anvContent, anvGrid, "")
Rel_D(anvContent, anvS3, "")
Rel_D(anvContent, anvOzone, "")

' Layout hints
Lay_R(anvApi, anvJob)
Lay_R(anvJob, anvHandler)
Lay_R(anvNotarization, anvVault)
Lay_R(anvNode, anvContent)
Lay_R(anvMongo, anvGrid)
Lay_R(anvGrid, anvS3)
Lay_R(anvS3, anvOzone)

legend bottom left
  Content storage: select one of S3, GridFS or Ozone.
  Node operations and background jobs coordinate through MongoDB-backed ShedLock leases.
  Key rotation and integrity sweeps are available through REST APIs and maintenance services.
  Operation and integrity metrics are exported to Prometheus / Grafana.
endlegend
@enduml
